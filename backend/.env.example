MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/scansafe?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_REFRESH_SECRET=your_refresh_token_secret_here_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
PORT=5000
NODE_ENV=development

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-6

# Open Food Facts (no key required)
OFF_BASE_URL=https://world.openfoodfacts.org/api/v2

# USDA FoodData Central
USDA_API_KEY=your_usda_api_key_here
USDA_BASE_URL=https://api.nal.usda.gov/fdc/v1

# Firebase Admin (for Google Sign-In verification)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
